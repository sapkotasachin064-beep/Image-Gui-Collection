{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ImGui OpenGL Base Release x64",
      "type": "process",
      "command": "${env:ProgramFiles}/Microsoft Visual Studio/2022/Community/MSBuild/Current/Bin/MSBuild.exe",
      "args": [
        "${workspaceFolder}/ImGui OpenGL Base.sln",
        "/t:Build",
        "/p:Configuration=Release",
        "/p:Platform=x64",
        "/m",
        "/v:minimal"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "showReuseMessage": false
      }
    }
  ]
}
